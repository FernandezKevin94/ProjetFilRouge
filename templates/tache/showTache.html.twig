{% extends 'base.html.twig' %}

{% block title %}Tâche{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="{{ path('app_tache_index', {'id': tache.id}) }}" class="btn btn-outline-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
            <path d="M177.5 414c-8.8 3.8-19 2-26-4.6l-144-136C2.7 268.9 0 262.6 0 256s2.7-12.9 7.5-17.4l144-136c7-6.6 17.2-8.4 26-4.6s14.5 12.5 14.5 22l0 72 288 0c17.7 0 32 14.3 32 32l0 64c0 17.7-14.3 32-32 32l-288 0 0 72c0 9.6-5.7 18.2-14.5 22z"/></svg>
            <span class="ms-2">Retour</span>
        </a>
        
        <a href="{{ path('app_tache_edit', {'id': tache.id}) }}" class="btn btn-outline-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
            <path d="M362.7 19.3L314.3 67.7 444.3 197.7l48.4-48.4c25-25 25-65.5 0-90.5L453.3 19.3c-25-25-65.5-25-90.5 0zm-71 71L58.6 323.5c-10.4 10.4-18 23.3-22.2 37.4L1 481.2C-1.5 489.7 .8 498.8 7 505s15.3 8.5 23.7 6.1l120.3-35.4c14.1-4.2 27-11.8 37.4-22.2L421.7 220.3 291.7 90.3z"/></svg>
            <span class="ms-2">Éditer</span>
        </a>
    </div>

    <h1 class="text-center mb-4">Détails de la Tâche</h1>
    
    <div class="card text-white bg-dark mx-auto" style="max-width: 600px;">
        <div class="card-header text-center">Tâche</div>
        <div class="card-body">
            <h5 class="card-title text-center">{{ tache.titre }}</h5>
            <p class="card-text">{{ tache.description }}</p>
            <ul class="list-group list-group-flush bg-dark text-white">
                <li class="list-group-item bg-dark text-white"><strong>ID :</strong> {{ tache.id }}</li>
                <li class="list-group-item bg-dark text-white"><strong>Date Limite :</strong> {{ tache.dateLimite ? tache.dateLimite|date('d-m-Y H:i:s') : '' }}</li>
                <li class="list-group-item bg-dark text-white"><strong>Status :</strong> {{ tache.status }}</li>
                <div class="text-center mt-3">
        {{ include('tache/deleteTache.html.twig') }}
    </div>
            </ul>
        </div>
    </div>
</div>
{% endblock %}