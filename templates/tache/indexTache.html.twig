{% extends 'base.html.twig' %}

{% block title %}Tâches{% endblock %}

{% block body %}

<div class="banner bg-dark text-white text-center py-4 mb-4">
    <div class="container">
        <h1 class="display-4">Gestion de Tâches</h1>
        <p class="lead">Visualisez, gérez et suivez l'avancement de vos tâches en toute simplicité.</p>
    </div>
</div>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="{{ path('app_projet_index') }}" class="btn btn-outline-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
            <path d="M177.5 414c-8.8 3.8-19 2-26-4.6l-144-136C2.7 268.9 0 262.6 0 256s2.7-12.9 7.5-17.4l144-136c7-6.6 17.2-8.4 26-4.6s14.5 12.5 14.5 22l0 72 288 0c17.7 0 32 14.3 32 32l0 64c0 17.7-14.3 32-32 32l-288 0 0 72c0 9.6-5.7 18.2-14.5 22z"/></svg>
            <span class="ms-2">Retour</span>
        </a>
        
        <a href="{{ path('app_tache_new', {'id': id_projet }) }}" class="btn btn-outline-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" height="32" width="28" viewBox="0 0 448 512">
            <path d="M256 80c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 144L48 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l144 0 0 144c0 17.7 14.3 32 32 32s32-14.3 32-32l0-144 144 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-144 0 0-144z"/></svg>
            Ajouter une tâche
        </a>
    </div>

    <h1 class="text-center mb-4">Liste des Tâches</h1>
    
    <div class="row">
        {% for tache in taches %}
            <div class="col-md-4">
                <div class="card text-white bg-dark mb-3">
                    <div class="card-header text-center">Tâche</div>
                    <div class="card-body">
                        <h5 class="card-title text-center">{{ tache.titre }}</h5>
                        <p class="card-text">{{ tache.description }}</p>
                        <ul class="list-group list-group-flush bg-dark text-white">
                            <li class="list-group-item bg-dark text-white"><strong>ID :</strong> {{ tache.id }}</li>
                            <li class="list-group-item bg-dark text-white"><strong>Date Limite :</strong> {{ tache.dateLimite ? tache.dateLimite|date('d-m-Y H:i:s') : '' }}</li>
                            <li class="list-group-item bg-dark text-white"><strong>Status :</strong> {{ tache.status }}</li>
                            <li class="list-group-item bg-dark text-white">
                                <strong>Utilisateur Affilé :</strong>
                                {% if tache.user %}
                                    {{ tache.user.firstName }} {{ tache.user.lastName }}
                                    <a href="{{ path('exclude_from_tache', {'id': tache.id}) }}" class="btn btn-primary btn-sm">Supprimer</a>
                                {% else %}
                                    Aucun utilisateur affecté
                                {% endif %}
                            </li>
                        </ul>
                        <div class="d-flex justify-content-center gap-2 mt-3">
                            <a href="{{ path('app_tache_show', {'id': tache.id}) }}" class="btn btn-primary btn-sm">Voir</a>
                            <a href="{{ path('app_tache_edit', {'id': tache.id}) }}" class="btn btn-warning btn-sm">Éditer</a>
                            <a href="{{ path('app_tache_affecter', {'id': tache.id}) }}" class="btn btn-outline-light btn-sm">Assigner</a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center text-muted">Aucune tâche trouvée</div>
        {% endfor %}
    </div>
</div>
{% endblock %}

