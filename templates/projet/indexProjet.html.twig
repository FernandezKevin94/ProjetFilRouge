{% extends 'base.html.twig' %}

{% block title %}Projet index{% endblock %}

{% block body %}

<div class="banner bg-dark text-white text-center py-4 mb-4">
    <div class="container">
        <h1 class="display-4">Gestion de Projets</h1>
        <p class="lead">Visualisez, gérez et suivez l'avancement de vos projets en toute simplicité.</p>
    </div>
</div>

<div class="text-end mt-3">
    <a href="{{ path('app_projet_new') }}" class="btn btn-outline-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" height="32" width="28" viewBox="0 0 448 512">
            <path d="M256 80c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 144L48 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l144 0 0 144c0 17.7 14.3 32 32 32s32-14.3 32-32l0-144 144 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-144 0 0-144z"/>
        </svg>
        <span>Nouveau Projet</span>
    </a>
</div>

<h1 class="text-center mb-4">Projet index</h1>

<div class="row">
    {% for projet in projets %}
        <div class="col-md-4 mb-4">
            <div class="card text-white bg-dark">
                <div class="card-body">
                    <h5 class="card-title">{{ projet.titre }}</h5>
                    <p class="card-text">{{ projet.Description }}</p>
                    <p class="card-text"><small class="text-light">Début: {{ projet.dateDebut ? projet.dateDebut|date('d-m-Y') : 'N/A' }} | Fin: {{ projet.dateFin ? projet.dateFin|date('d-m-Y') : 'N/A' }}</small></p>
                    <p class="card-text"><strong>Status:</strong> {{ projet.status }}</p>
                    <p class="card-text"><strong>Chef de projet:</strong> {{ projet.ChefDeProjet }}</p>
                    <div class="d-flex justify-content-between">
                        <a href="{{ path('app_projet_show', {'id': projet.id}) }}" class="btn btn-primary btn-sm">Voir</a>
                        <a href="{{ path('app_projet_edit', {'id': projet.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <p class="text-center text-muted">Aucun projet trouvé.</p>
    {% endfor %}
</div>

{% endblock %}
