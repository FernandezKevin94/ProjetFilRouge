{% extends 'base.html.twig' %}

{% block title %}Affecter une tâche{% endblock %}

{% block body %}

<div class="mt-3">
<a href="{{ path('app_projet_index') }}" class="btn btn-outline-secondary">
    <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
    <path d="M177.5 414c-8.8 3.8-19 2-26-4.6l-144-136C2.7 268.9 0 262.6 0 256s2.7-12.9 7.5-17.4l144-136c7-6.6 17.2-8.4 26-4.6s14.5 12.5 14.5 22l0 72 288 0c17.7 0 32 14.3 32 32l0 64c0 17.7-14.3 32-32 32l-288 0 0 72c0 9.6-5.7 18.2-14.5 22z"/></svg>
    <span class="ms-2">Retour</span>
    </a>
    </div>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="card shadow-sm p-3 bg-dark">
                <h3 class="mb-3 text-light">Filtrer</h3>
                <div class="text-light">
                {{ form(f) }}
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <h4 class="mb-4">Membres</h4>
            <div class="row row-cols-1 row-cols-md-3 g-3">
                {% for user in users %}
                    <div class="col">
                        <div class="card text-center shadow-sm border-0 bg-dark">
                            <div class="card-body">
                                <h5 class="card-title text-light">{{ user.matricule }}</h5>
                                <h6 class="card-subtitle mb-3 text-light">{{ user.firstName }}</h6>
                                <a href="{{ path('app_add_team', {'id': user.id}) }}" class="btn btn-outline-light">
                                    Choisir
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
