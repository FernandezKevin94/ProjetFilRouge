{% extends 'base.html.twig' %}

{% block title %}Mes Projets{% endblock %}

{% block body %}

<div class="mt-3">
<a href="{{ path('app_profil') }}" class="btn btn-outline-secondary">
    <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
    <path d="M177.5 414c-8.8 3.8-19 2-26-4.6l-144-136C2.7 268.9 0 262.6 0 256s2.7-12.9 7.5-17.4l144-136c7-6.6 17.2-8.4 26-4.6s14.5 12.5 14.5 22l0 72 288 0c17.7 0 32 14.3 32 32l0 64c0 17.7-14.3 32-32 32l-288 0 0 72c0 9.6-5.7 18.2-14.5 22z"/></svg>
    <span class="ms-2">Retour</span>
    </a>
    </div>

    <h1 class="text-center mb-3">Mes Projets</h1>

    {% if projets is empty %}
        <p>Vous n'êtes affecté à aucun projet.</p>
    {% else %}
        <div class="row">
            {% for projet in projets %}
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-dark text-white">
                            <h5 class="card-title">{{ projet.titre }}</h5>
                             <a href="{{ path('app_tache_index', {'id': projet.id}) }}" class="btn btn-primary btn-sm">Voir mes tâches</a>
                        </div>
                        <div class="card-body">
                            <p><strong>Description :</strong> {{ projet.description }}</p>
                            <p><strong>Date de début :</strong> {{ projet.dateDebut|date('d/m/Y') }}</p>
                            <p><strong>Date de fin :</strong> {{ projet.dateFin|date('d/m/Y') }}</p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
