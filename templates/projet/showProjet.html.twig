{% extends 'base.html.twig' %}

{% block title %}Projet{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="{{ path('app_projet_index') }}" class="btn btn-outline-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
            <path d="M177.5 414c-8.8 3.8-19 2-26-4.6l-144-136C2.7 268.9 0 262.6 0 256s2.7-12.9 7.5-17.4l144-136c7-6.6 17.2-8.4 26-4.6s14.5 12.5 14.5 22l0 72 288 0c17.7 0 32 14.3 32 32l0 64c0 17.7-14.3 32-32 32l-288 0 0 72c0 9.6-5.7 18.2-14.5 22z"/></svg>
            <span class="ms-2">Retour</span>
        </a>
        
        <div>
            <a href="{{ path('app_projet_edit', {'id': projet.id}) }}" class="btn btn-warning btn-sm me-2">Éditer</a>
            <a href="{{ path('app_projet_affecter', {'id' : projet.id}) }}" class="btn btn-secondary btn-sm me-2">Ajout de membres</a>
            <a href="{{ path('app_tache_index', {'id': projet.id}) }}" class="btn btn-primary btn-sm">Voir les tâches</a>
        </div>
    </div>

    <div class="card text-white bg-dark mb-3">
        <div class="card-header text-center">Projet</div>
        <div class="card-body">
            <h5 class="card-title text-center">{{ projet.titre }}</h5>
            <p class="card-text">{{ projet.Description }}</p>
            <ul class="list-group list-group-flush bg-dark text-white">
                <li class="list-group-item bg-dark text-white"><strong>ID :</strong> {{ projet.id }}</li>
                <li class="list-group-item bg-dark text-white"><strong>Date de début :</strong> {{ projet.dateDebut ? projet.dateDebut|date('d-m-Y H:i:s') : '' }}</li>
                <li class="list-group-item bg-dark text-white"><strong>Date de fin :</strong> {{ projet.dateFin ? projet.dateFin|date('d-m-Y H:i:s') : '' }}</li>
                <li class="list-group-item bg-dark text-white"><strong>Status :</strong> {{ projet.status }}</li>
                <li class="list-group-item bg-dark text-white"><strong>Chef de projet :</strong> {{ projet.ChefDeProjet }}</li>
                <li class="list-group-item bg-dark text-white"><strong>Membres affiliés :</strong>
             {% if projet.user is not empty %}
               <ul>
                 {% for membre in projet.user %}
                <li>{{ membre.firstName }} {{ membre.lastName }} - {{ membre.email }}</li>
                {# <a href="{{ path('exclude_from_tache', {'id': tache.user.id}) }}" class="btn btn-primary btn-sm">Supprimer</a> #}
            {% endfor %}
                 </ul>
             {% else %}
              Aucun membre affilié.
            {% endif %}
            <div class="text-end">
            {{ include('projet/deleteProjet.html.twig') }}
            </div>
                </li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}