{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm rounded-lg">
                <div class="card-header bg-info text-white text-center">
                    <h1 class="card-title">Mon Profil</h1>
                </div>
                <div class="card-body text-center">
                    <p class="lead">Accédez à vos informations personnelles et gérez vos adresses.</p>
                    <div class="mt-4">
                        <a class="btn btn-primary btn-lg me-2" href="{{ path('app_user_index') }}" role="button">
                            <i class="bi bi-person"></i> Mes coordonnées
                        </a>
                        <a class="btn btn-secondary btn-lg" href="{{ path('app_adresse_index')}}" role="button">
                            <i class="bi bi-geo-alt"></i> Mes adresses
                        </a>
                    </div>
                </div>
                <div class="card-footer text-muted text-center">
                    Dernière mise à jour : {{ 'now'|date('d/m/Y H:i') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
