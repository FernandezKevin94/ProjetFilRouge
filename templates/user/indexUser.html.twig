{% extends 'base.html.twig' %}

{% block title %}User Index{% endblock %}

{% block body %}
 
    <div class="mt-3">
        <a href="{{ path('app_profil') }}" class="btn btn-outline-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
                <path d="M177.5 414c-8.8 3.8-19 2-26-4.6l-144-136C2.7 268.9 0 262.6 0 256s2.7-12.9 7.5-17.4l144-136c7-6.6 17.2-8.4 26-4.6s14.5 12.5 14.5 22v72h288c17.7 0 32 14.3 32 32v64c0 17.7-14.3 32-32 32h-288v72c0 9.6-5.7 18.2-14.5 22z"/>
            </svg>
        <span class="ms-2">Retour</span>
        </a>
    </div>

    {% if is_granted('ROLE_ADMIN') %}
    <div class="text-end mb-3">
        <a href="{{ path('app_user_new') }}" class="btn btn-outline-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="F00000" class="bi bi-person-add" viewBox="0 0 16 16">
                <path d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m.5-5v1h1a.5.5 0 0 1 0 1h-1v1a.5.5 0 0 1-1 0v-1h-1a.5.5 0 0 1 0-1h1v-1a.5.5 0 0 1 1 0m-2-6a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4"/>
                <path d="M8.256 14a4.5 4.5 0 0 1-.229-1.004H3c.001-.246.154-.986.832-1.664C4.484 10.68 5.711 10 8 10q.39 0 .74.025c.226-.341.496-.65.804-.918Q8.844 9.002 8 9c-5 0-6 3-6 4s1 1 1 1z"/>
            </svg>
        <span class="ms-2">Ajout d'utilisateurs</span>
        </a>
    </div>
    {% endif %}

    <h1 class="text-center mb-4">Mes coordonnées</h1>

    <div class="container-fluid"> 
    <div class="row row-cols-1 row-cols-md-2 g-4">
        {% for user in users %}
            <div class="col mx-auto mt-2">
                <div class="card text-white bg-dark h-100">
                    <div class="card-body">
                        <h5 class="card-title">{{ user.firstName }} {{ user.lastName }}</h5>
                        <p class="card-text"><strong>Email:</strong> {{ user.email }}</p>
                        <p class="card-text"><strong>Matricule:</strong> {{ user.matricule }}</p>
                        <p class="card-text"><strong>Anniversaire:</strong> {{ user.birthday ? user.birthday|date('d-m-Y') : 'N/A' }}</p>
                        <p class="card-text"><strong>Téléphone:</strong> {{ user.telephone }}</p>
                        <p class="card-text"><strong>Service:</strong> {{ user.service }}</p>
                        <p class="card-text"><strong>Spécialité:</strong> {{ user.speciality }}</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-primary btn-sm">
                            Voir
                        </a>
                        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-warning btn-sm">
                            Modifier
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center text-muted">
                Aucun utilisateur trouvé.
            </div>
        {% endfor %}
    </div>
    </div>

    <a class="btn btn-primary btn-lg mt-4 d-block mx-auto" href="{{ path('app_adresse_index') }}" role="button">
        Accès aux adresses
    </a>

{% endblock %}
