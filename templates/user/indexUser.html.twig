{% extends 'base.html.twig' %}

{% block title %}User Index{% endblock %}

{% block body %}

    <!-- Bouton Retour -->
    <div class="mt-3">
        <a href="{{ path('app_profil') }}" class="btn btn-outline-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
                <path d="M177.5 414c-8.8 3.8-19 2-26-4.6l-144-136C2.7 268.9 0 262.6 0 256s2.7-12.9 7.5-17.4l144-136c7-6.6 17.2-8.4 26-4.6s14.5 12.5 14.5 22v72h288c17.7 0 32 14.3 32 32v64c0 17.7-14.3 32-32 32h-288v72c0 9.6-5.7 18.2-14.5 22z"/>
            </svg>
        <span class="ms-2">Retour</span>
        </a>
    </div>

    <!-- Bouton Ajouter -->
    <div class="text-end mb-3">
        <a href="{{ path('app_user_new') }}" class="btn btn-outline-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="F00000" class="bi bi-person-add" viewBox="0 0 16 16">
                <path d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m.5-5v1h1a.5.5 0 0 1 0 1h-1v1a.5.5 0 0 1-1 0v-1h-1a.5.5 0 0 1 0-1h1v-1a.5.5 0 0 1 1 0m-2-6a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4"/>
                <path d="M8.256 14a4.5 4.5 0 0 1-.229-1.004H3c.001-.246.154-.986.832-1.664C4.484 10.68 5.711 10 8 10q.39 0 .74.025c.226-.341.496-.65.804-.918Q8.844 9.002 8 9c-5 0-6 3-6 4s1 1 1 1z"/>
            </svg>
        <span class="ms-2">Ajout d'utilisateurs</span>
        </a>
    </div>

    <h1 class="text-center mb-4">Liste des utilisateurs</h1>

        <div class="table-responsive">
            <table class="table table-dark table-hover table-striped table-bordered align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Id</th>
                        <th>Email</th>
                        <th>Rôles</th>
                        <th>Matricule</th>
                        <th>Prénom</th>
                        <th>Nom</th>
                        <th>Anniversaire</th>
                        <th>Téléphone</th>
                        <th>Service</th>
                        <th>Spécialité</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if app.user %}
                        <tr class="text-center">
                            <td>{{ app.user.id }}</td>
                            <td>{{ app.user.email }}</td>
                            <td>{{ app.user.roles ? app.user.roles|json_encode : '' }}</td>
                            <td>{{ app.user.matricule }}</td>
                            <td>{{ app.user.firstName }}</td>
                            <td>{{ app.user.lastName }}</td>
                            <td>{{ app.user.birthday ? app.user.birthday|date('d-m-Y') : 'N/A' }}</td>
                            <td>{{ app.user.telephone }}</td>
                            <td>{{ app.user.service }}</td>
                            <td>{{ app.user.speciality }}</td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <!-- Voir -->
                                    <a href="{{ path('app_user_show', {'id': app.user.id}) }}" class="btn btn-primary btn-sm">
                                        <svg xmlns="http://www.w3.org/2000/svg" height="32" width="36" viewBox="0 0 576 512">
                                            <path fill="#ffffff" d="M288 32c-80.8 0-145.5 36.8-192.6 80.6C48.6 156 17.3 208 2.5 243.7c-3.3 7.9-3.3 16.7 0 24.6C17.3 304 48.6 356 95.4 399.4C142.5 443.2 207.2 480 288 480s145.5-36.8 192.6-80.6c46.8-43.5 78.1-95.4 93-131.1c3.3-7.9 3.3-16.7 0-24.6c-14.9-35.7-46.2-87.7-93-131.1C433.5 68.8 368.8 32 288 32zM144 256a144 144 0 1 1 288 0 144 144 0 1 1 -288 0z"/>
                                        </svg>
                                    </a>

                                    <!-- Modifier -->
                                    <a href="{{ path('app_user_edit', {'id': app.user.id}) }}" class="btn btn-warning btn-sm">
                                        <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
                                            <path fill="#ffffff" d="M362.7 19.3L314.3 67.7 444.3 197.7l48.4-48.4c25-25 25-65.5 0-90.5L453.3 19.3c-25-25-65.5-25-90.5 0zm-71 71L58.6 323.5c-10.4 10.4-18 23.3-22.2 37.4L1 481.2C-1.5 489.7 .8 498.8 7 505s15.3 8.5 23.7 6.1l120.3-35.4c14.1-4.2 27-11.8 37.4-22.2L421.7 220.3 291.7 90.3z"/>
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="11" class="text-center text-muted">Aucun utilisateur trouvé.</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
        <a class="btn btn-primary btn-lg me-2" href="{{ path('app_adresse_index',)}}" role="button">
        Accès aux adresses</a>
{% endblock %}
