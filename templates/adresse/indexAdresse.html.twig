{% extends 'base.html.twig' %}

{% block title %}Adresse index{% endblock %}

{% block body %}

<div class="mt-3">
    <a href="{{ path('app_profil') }}" class="btn btn-outline-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
            <path d="M177.5 414c-8.8 3.8-19 2-26-4.6l-144-136C2.7 268.9 0 262.6 0 256s2.7-12.9 7.5-17.4l144-136c7-6.6 17.2-8.4 26-4.6s14.5 12.5 14.5 22v72h288c17.7 0 32 14.3 32 32v64c0 17.7-14.3 32-32 32h-288v72c0 9.6-5.7 18.2-14.5 22z"/>
        </svg>
        <span class="ms-2">Retour</span>
    </a>
</div>

<div class="text-end mb-3">
    <a href="{{ path('app_adresse_new') }}" class="btn btn-outline-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" height="32" width="28" viewBox="0 0 448 512">
            <path d="M256 80c0-17.7-14.3-32-32-32s-32 14.3-32 32v144H48c-17.7 0-32 14.3-32 32s14.3 32 32 32h144v144c0 17.7 14.3 32 32 32s32-14.3 32-32V288h144c17.7 0 32-14.3 32-32s-14.3-32-32-32H256V80z"/>
        </svg>
        <span class="ms-2">Ajout d'adresses</span>
    </a>
</div>

<h1 class="text-center mb-4">Mes adresses</h1>

<div class="container-fluid">
<div class="row row-cols-1 row-cols-md-3 g-4">
    {% for adresse in app.user.adresses %}
        <div class="col mx-auto mb-1">
            <div class="card text-white bg-dark h-100">
                <div class="card-body">
                    <h5 class="card-title">{{ adresse.titre }}</h5>
                    <p class="card-text"><strong>Nom:</strong> {{ adresse.firstname }} {{ adresse.lastname }}</p>
                    <p class="card-text"><strong>Adresse:</strong> {{ adresse.adresse }}</p>
                    <p class="card-text"><strong>Ville:</strong> {{ adresse.ville }}</p>
                    <p class="card-text"><strong>Code postal:</strong> {{ adresse.codepostal }}</p>
                    <p class="card-text"><strong>Pays:</strong> {{ adresse.pays }}</p>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a href="{{ path('app_adresse_show', {'id': adresse.id}) }}" class="btn btn-primary btn-sm">
                        Voir
                    </a>
                    <a href="{{ path('app_adresse_edit', {'id': adresse.id}) }}" class="btn btn-warning btn-sm">
                        Modifier
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center text-muted">
            Aucun enregistrement trouvé.
        </div>
    {% endfor %}
</div>
</div>

<a class="btn btn-primary btn-lg mt-5 d-block mx-auto" href="{{ path('app_user_index') }}" role="button">
    Accès aux coordonnées
</a>

{% endblock %}
