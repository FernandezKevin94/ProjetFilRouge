{% extends 'base.html.twig' %}

{% block title %}Adresse index{% endblock %}

{% block body %}

<div class="mt-3">
<a href="{{ path('app_profil') }}" class="btn btn-outline-secondary">
    <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
    <path d="M177.5 414c-8.8 3.8-19 2-26-4.6l-144-136C2.7 268.9 0 262.6 0 256s2.7-12.9 7.5-17.4l144-136c7-6.6 17.2-8.4 26-4.6s14.5 12.5 14.5 22l0 72 288 0c17.7 0 32 14.3 32 32l0 64c0 17.7-14.3 32-32 32l-288 0 0 72c0 9.6-5.7 18.2-14.5 22z"/></svg>
    <span class="ms-2">Retour</span>
    </a>
    </div>

    <div class="text-end mb-3">
 <a href="{{ path('app_adresse_new') }}" class="btn btn-outline-secondary">
    <svg xmlns="http://www.w3.org/2000/svg" height="32" width="28" viewBox="0 0 448 512">
    <path d="M256 80c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 144L48 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l144 0 0 144c0 17.7 14.3 32 32 32s32-14.3 32-32l0-144 144 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-144 0 0-144z"/></svg>
    <span class="ms-2">Ajout d'adresses</span>
    </a>
    </div>

    <h1 class="text-center mb-4">Adresse index</h1>

    <div class="table-responsive">
    <table class="table table-dark table-hover table-striped table-bordered align-middle">
        <thead class="table-dark text-center">
            <tr>
                {# <th>Id</th> #}
                <th>Titre</th>
                <th>Firstname</th>
                <th>Lastname</th>
                <th>Adresse</th>
                <th>Ville</th>
                <th>Codepostal</th>
                <th>Pays</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for adresse in app.user.adresses %}
            <tr class="text-center">
                {# <td>{{ adresse.id }}</td> #}
                <td>{{ adresse.titre }}</td>
                <td>{{ adresse.firstname }}</td>
                <td>{{ adresse.lastname }}</td>
                <td>{{ adresse.adresse }}</td>
                <td>{{ adresse.ville }}</td>
                <td>{{ adresse.codepostal }}</td>
                <td>{{ adresse.pays }}</td>
                <td>
                <div class="d-flex justify-content-center gap-2">
                    <a href="{{ path('app_adresse_show', {'id': adresse.id}) }}" class="btn btn-primary btn-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" height="32" width="36" viewBox="0 0 576 512">
                    <path fill="#ffffff" d="M288 32c-80.8 0-145.5 36.8-192.6 80.6C48.6 156 17.3 208 2.5 243.7c-3.3 7.9-3.3 16.7 0 24.6C17.3 304 48.6 356 95.4 399.4C142.5 443.2 207.2 480 288 480s145.5-36.8 192.6-80.6c46.8-43.5 78.1-95.4 93-131.1c3.3-7.9 3.3-16.7 0-24.6c-14.9-35.7-46.2-87.7-93-131.1C433.5 68.8 368.8 32 288 32zM144 256a144 144 0 1 1 288 0 144 144 0 1 1 -288 0zm144-64c0 35.3-28.7 64-64 64c-7.1 0-13.9-1.2-20.3-3.3c-5.5-1.8-11.9 1.6-11.7 7.4c.3 6.9 1.3 13.8 3.2 20.7c13.7 51.2 66.4 81.6 117.6 67.9s81.6-66.4 67.9-117.6c-11.1-41.5-47.8-69.4-88.6-71.1c-5.8-.2-9.2 6.1-7.4 11.7c2.1 6.4 3.3 13.2 3.3 20.3z"/></svg>
                    </a>
    
                    <a href="{{ path('app_adresse_edit', {'id': adresse.id}) }}" class="btn btn-warning btn-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
                    <path fill="#ffffff" d="M362.7 19.3L314.3 67.7 444.3 197.7l48.4-48.4c25-25 25-65.5 0-90.5L453.3 19.3c-25-25-65.5-25-90.5 0zm-71 71L58.6 323.5c-10.4 10.4-18 23.3-22.2 37.4L1 481.2C-1.5 489.7 .8 498.8 7 505s15.3 8.5 23.7 6.1l120.3-35.4c14.1-4.2 27-11.8 37.4-22.2L421.7 220.3 291.7 90.3z"/></svg>
                    </a>
                </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="1" class="text-center text-muted">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
<a class="btn btn-primary btn-lg me-2" href="{{ path('app_user_index',)}}" role="button">
        Accès aux coordonnées</a>
{% endblock %}
